 // answer is both known and final -- after the stop hook has had its 200 ms of
 // JS_ExecutePendingJob, before JS_FreeRuntime discards whatever is left.
 static pocketjs_guest_stats_t final_stats;
+// MEASUREMENT ONLY (docs/kasane/kasane-guest-memory.md): every JSMemoryUsage
+// field before and after one forced GC, so live bytes and uncollected garbage
+// are separate numbers. The GC here exists for the reading and nothing else.
+static bool memprobe_first_done, memprobe_f300_done;
+static void memprobe_line(const char *phase, const char *gc, JSRuntime *rt) {
+    JSMemoryUsage u;
+    JS_ComputeMemoryUsage(rt,&u);
+    ESP_LOGI("app","MEMPROBE %s %s app=%s free=%u largest=%u malloc_size=%lld malloc_count=%lld "
+        "memory_used_size=%lld memory_used_count=%lld atom_count=%lld atom_size=%lld "
+        "str_count=%lld str_size=%lld obj_count=%lld obj_size=%lld prop_count=%lld prop_size=%lld "
+        "shape_count=%lld shape_size=%lld js_func_count=%lld js_func_size=%lld js_func_code_size=%lld "
+        "js_func_pc2line_count=%lld js_func_pc2line_size=%lld c_func_count=%lld array_count=%lld "
+        "fast_array_count=%lld fast_array_elements=%lld binary_object_count=%lld binary_object_size=%lld frames=%u",
+        phase,gc,app_registry_current()->id,
+        (unsigned)heap_caps_get_free_size(MALLOC_CAP_INTERNAL|MALLOC_CAP_8BIT),
+        (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL|MALLOC_CAP_8BIT),
+        (long long)u.malloc_size,(long long)u.malloc_count,(long long)u.memory_used_size,
+        (long long)u.memory_used_count,(long long)u.atom_count,(long long)u.atom_size,
+        (long long)u.str_count,(long long)u.str_size,(long long)u.obj_count,(long long)u.obj_size,
+        (long long)u.prop_count,(long long)u.prop_size,(long long)u.shape_count,(long long)u.shape_size,
+        (long long)u.js_func_count,(long long)u.js_func_size,(long long)u.js_func_code_size,
+        (long long)u.js_func_pc2line_count,(long long)u.js_func_pc2line_size,(long long)u.c_func_count,
+        (long long)u.array_count,(long long)u.fast_array_count,(long long)u.fast_array_elements,
+        (long long)u.binary_object_count,(long long)u.binary_object_size,frames);
+}
+static void memprobe(const char *phase) {
+    JSContext *ctx=guest?pocketjs_guest_quickjs_context(guest):NULL;
+    if(!ctx) return;
+    JSRuntime *rt=JS_GetRuntime(ctx);
+    memprobe_line(phase,"pre",rt);
+    JS_RunGC(rt);
+    memprobe_line(phase,"post",rt);
+}
