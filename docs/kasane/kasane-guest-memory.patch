diff --git a/tools/kasane_memprobe_run.py b/tools/kasane_memprobe_run.py
new file mode 100644
index 0000000..021a8ee
--- /dev/null
+++ b/tools/kasane_memprobe_run.py
@@ -0,0 +1,62 @@
+"""Launch apps from the home menu with no input, collect MEMPROBE lines.
+
+    python memprobe_run.py --port COM3 --label kas_on --runs 2 --out log.txt
+"""
+import argparse, time, serial
+
+p = argparse.ArgumentParser()
+p.add_argument('--port', required=True)
+p.add_argument('--label', required=True)
+p.add_argument('--runs', type=int, default=2)
+p.add_argument('--out', required=True)
+a = p.parse_args()
+
+APPS = [(4, 'imucal'), (6, 'companion'), (5, 'pet')]
+s = serial.Serial(a.port, 115200, timeout=0.05)
+out = open(a.out, 'a', encoding='utf-8')
+
+
+def log(line):
+    out.write(f'{a.label} {line}\n'); out.flush()
+
+
+def wait(marker, limit=30, keep=False):
+    end = time.monotonic() + limit
+    seen = []
+    while time.monotonic() < end:
+        line = s.readline().decode(errors='replace').strip()
+        if not line:
+            continue
+        seen.append(line)
+        if 'MEMPROBE' in line or 'MEM free' in line or 'START_FAILED' in line or 'abort' in line.lower() or 'Guru' in line:
+            log(line)
+        if marker in line:
+            return line
+    raise RuntimeError(f'waiting for {marker}: {seen[-10:]}')
+
+
+time.sleep(1.5)
+s.reset_input_buffer()
+s.write(b'q')
+try:
+    wait('HOME_READY', 10)
+except RuntimeError:
+    pass
+s.write(b'a'); wait('CATEGORY 0', 5)
+for run in range(a.runs):
+    for index, name in APPS:
+        for _ in range(8):
+            s.write(b'u'); time.sleep(0.12)
+        for _ in range(index):
+            s.write(b'd'); time.sleep(0.12)
+        wait(f'APP {index}', 5)
+        s.reset_input_buffer()
+        log(f'RUN {run} {name}')
+        s.write(b'e')
+        wait('MEMPROBE first post', 30)
+        wait('MEMPROBE f300 post', 60)
+        s.write(b'q')
+        wait('MEMPROBE stop post', 20)
+        wait('HOME_READY', 20)
+        time.sleep(1.0)
+s.close()
diff --git a/tools/kasane_memprobe_parse.py b/tools/kasane_memprobe_parse.py
new file mode 100644
index 0000000..e10e2f2
--- /dev/null
+++ b/tools/kasane_memprobe_parse.py
@@ -0,0 +1,48 @@
+import re, collections, sys
+LOG = sys.argv[1]
+rows = collections.defaultdict(list)   # (build, app, phase, gc) -> [dict]
+arena = collections.defaultdict(list)
+fails = []
+cur = None
+for line in open(LOG, encoding='utf-8'):
+    build = line.split()[0]
+    m = re.search(r'RUN (\d) (\w+)', line)
+    if m: cur = m.group(2); continue
+    if 'START_FAILED' in line or 'Guru' in line: fails.append(line.strip())
+    m = re.search(r'MEMPROBE (first|f300|stop) (pre|post) app=local\.(\w+) (.*)', line)
+    if m:
+        d = {k: int(v) for k, v in re.findall(r'(\w+)=(-?\d+)', m.group(4))}
+        rows[(build, m.group(3), m.group(1), m.group(2))].append(d)
+        continue
+    m = re.search(r'MEMPROBE arena (before|after) (.*)', line)
+    if m and cur:
+        d = {k: int(v) for k, v in re.findall(r'(\w+)=(\d+)', m.group(2))}
+        arena[(build, cur, m.group(1))].append(d)
+print('fails', fails)
+F = ['malloc_size','memory_used_size','malloc_count','atom_count','atom_size','str_count','str_size','obj_count','obj_size',
+     'prop_count','prop_size','shape_count','shape_size','js_func_count','js_func_size','js_func_code_size',
+     'js_func_pc2line_size','c_func_count','array_count','fast_array_elements','binary_object_count','binary_object_size','free','largest']
+def avg(lst, k): return sum(d[k] for d in lst) / len(lst)
+def spread(lst, k): return max(d[k] for d in lst) - min(d[k] for d in lst)
+builds = ['old_on','kas_on','old_off','kas_off']
+apps = ['imucal','companion','pet']
+print('\n## pre/post malloc_size per build/app/phase (n, pre, post, spread)')
+for b in builds:
+    for a in apps:
+        for ph in ['first','f300','stop']:
+            pre = rows.get((b,a,ph,'pre')); post = rows.get((b,a,ph,'post'))
+            if not pre: print(b,a,ph,'MISSING'); continue
+            print(f'{b:8} {a:9} {ph:5} n={len(pre)} pre={avg(pre,"malloc_size"):.0f} post={avg(post,"malloc_size"):.0f} '
+                  f'used={avg(post,"memory_used_size"):.0f} spread={spread(post,"malloc_size")} free={avg(post,"free"):.0f} largest={avg(post,"largest"):.0f}')
+print('\n## field table post-GC first & f300')
+for ph in ['first','f300']:
+    for a in apps:
+        print(f'\n### {a} {ph}')
+        print('field | ' + ' | '.join(builds) + ' | kas-old(on) | on-off(old) | on-off(kas)')
+        for k in F:
+            v = {b: avg(rows[(b,a,ph,'post')], k) for b in builds}
+            print(f'{k} | ' + ' | '.join(f'{v[b]:.0f}' for b in builds) +
+                  f' | {v["kas_on"]-v["old_on"]:+.0f} | {v["old_on"]-v["old_off"]:+.0f} | {v["kas_on"]-v["kas_off"]:+.0f}')
+print('\n## arena')
+for key, lst in sorted(arena.items()):
+    print(key, lst)
