{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cardputer design definition v0.1 (proposal)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "target", "tokens", "screens"],
  "properties": {
    "version": {"const": "0.1"},
    "target": {"const": "cardputer-adv"},
    "tokens": {"$ref": "#/$defs/tokens"},
    "screens": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {"$ref": "#/$defs/screen"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"},
    "rgba": {"type": "string", "pattern": "^#[0-9a-fA-F]{8}$"},
    "color": {"type": "string", "pattern": "^(#[0-9a-fA-F]{8}|@color/[a-z][a-z0-9_-]{0,31})$"},
    "rect": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {"type": "integer", "minimum": -32768, "maximum": 32767}
    },
    "tokens": {
      "type": "object", "additionalProperties": false,
      "required": ["colors", "spacing", "radii", "typography"],
      "properties": {
        "colors": {
          "type": "object", "minProperties": 1, "maxProperties": 32,
          "propertyNames": {"$ref": "#/$defs/id"},
          "additionalProperties": {"$ref": "#/$defs/rgba"}
        },
        "spacing": {"const": [2, 4, 8, 12, 16]},
        "radii": {"const": [0, 2, 4, 8]},
        "typography": {"const": "cardputer-flash-v1"}
      }
    },
    "fill": {
      "oneOf": [
        {"$ref": "#/$defs/color"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "axis", "from", "to", "dither"],
          "properties": {
            "kind": {"const": "linear"},
            "axis": {"enum": ["x", "y"]},
            "from": {"$ref": "#/$defs/color"},
            "to": {"$ref": "#/$defs/color"},
            "dither": {"type": "boolean"}
          }
        }
      ]
    },
    "border": {
      "type": "object", "additionalProperties": false,
      "required": ["width", "color"],
      "properties": {
        "width": {"enum": [1, 2]},
        "color": {"$ref": "#/$defs/color"}
      }
    },
    "base": {
      "type": "object", "required": ["id", "kind", "rect"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"type": "string"},
        "rect": {"$ref": "#/$defs/rect"},
        "clip": {"$ref": "#/$defs/rect"},
        "visible": {"type": "boolean"}
      }
    },
    "panel": {
      "allOf": [{"$ref": "#/$defs/base"}],
      "required": ["fill", "radius"], "unevaluatedProperties": false,
      "properties": {
        "kind": {"const": "panel"},
        "fill": {"$ref": "#/$defs/fill"},
        "radius": {"enum": [0, 2, 4, 8]},
        "border": {"$ref": "#/$defs/border"}
      }
    },
    "label": {
      "allOf": [{"$ref": "#/$defs/base"}],
      "required": ["text", "capacity", "font", "color"], "unevaluatedProperties": false,
      "properties": {
        "kind": {"const": "label"},
        "text": {"type": "string", "maxLength": 128},
        "capacity": {"type": "integer", "minimum": 1, "maximum": 128},
        "font": {"enum": ["caption", "body", "display"]},
        "color": {"$ref": "#/$defs/color"},
        "align": {"enum": ["start", "center", "end"]},
        "overflow": {"const": "clip"}
      }
    },
    "meter": {
      "allOf": [{"$ref": "#/$defs/base"}],
      "required": ["value", "track", "fill"], "unevaluatedProperties": false,
      "properties": {
        "kind": {"const": "meter"},
        "value": {"type": "integer", "minimum": 0, "maximum": 100},
        "track": {"$ref": "#/$defs/color"},
        "fill": {"$ref": "#/$defs/color"}
      }
    },
    "pet": {
      "allOf": [{"$ref": "#/$defs/base"}],
      "required": ["variant", "mood", "scale"], "unevaluatedProperties": false,
      "properties": {
        "kind": {"const": "pet"},
        "variant": {"type": "integer", "minimum": 0, "maximum": 11},
        "mood": {"type": "integer", "minimum": 0, "maximum": 5},
        "scale": {"enum": [0.5, 1]}
      }
    },
    "node": {"oneOf": [
      {"$ref": "#/$defs/panel"}, {"$ref": "#/$defs/label"},
      {"$ref": "#/$defs/meter"}, {"$ref": "#/$defs/pet"}
    ]},
    "nodes": {"type": "array", "maxItems": 80, "items": {"$ref": "#/$defs/node"}},
    "action": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "target", "event", "command"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "target": {"$ref": "#/$defs/id"},
        "event": {"enum": ["activate", "back"]},
        "command": {"$ref": "#/$defs/id"}
      }
    },
    "motion": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "target", "property", "from", "to", "durationMs", "easing", "repeat"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "target": {"$ref": "#/$defs/id"},
        "property": {"const": "translateY"},
        "from": {"type": "integer", "minimum": -135, "maximum": 135},
        "to": {"type": "integer", "minimum": -135, "maximum": 135},
        "durationMs": {"type": "integer", "minimum": 1, "maximum": 60000},
        "easing": {"enum": ["linear", "easeOutCubic", "easeInOutCubic", "step"]},
        "repeat": {"enum": ["once", "loop", "pingpong"]}
      }
    },
    "backdrop": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "downsample", "blurRadius", "tint", "fallback"],
      "properties": {
        "kind": {"const": "frosted-static"},
        "downsample": {"enum": [4, 8]},
        "blurRadius": {"enum": [1, 2]},
        "tint": {"$ref": "#/$defs/color"},
        "fallback": {"$ref": "#/$defs/color"}
      }
    },
    "modal": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "backdrop", "nodes", "focus", "actions"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "backdrop": {"$ref": "#/$defs/backdrop"},
        "nodes": {"$ref": "#/$defs/nodes"},
        "focus": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "actions": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/action"}}
      }
    },
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["commands", "textBytes", "tracks", "backdropBytes"],
      "properties": {
        "commands": {"type": "integer", "minimum": 1, "maximum": 80},
        "textBytes": {"type": "integer", "minimum": 0, "maximum": 896},
        "tracks": {"type": "integer", "minimum": 0, "maximum": 6},
        "backdropBytes": {"type": "integer", "minimum": 0, "maximum": 6144}
      }
    },
    "screen": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "background", "budget", "nodes"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "background": {"$ref": "#/$defs/color"},
        "budget": {"$ref": "#/$defs/budget"},
        "nodes": {"$ref": "#/$defs/nodes"},
        "focus": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "actions": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/action"}},
        "motions": {"type": "array", "maxItems": 6, "items": {"$ref": "#/$defs/motion"}},
        "modals": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/modal"}}
      }
    }
  }
}
