* text=auto
*.md text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.c text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.json text eol=lf
*.sh text eol=lf

# The host VM harness compares program output byte for byte, and it runs under
# WSL against a Windows checkout: expected output and the recorded baselines
# must stay LF or every case "fails" on the line endings alone.
tools/vmtest/expected/*.txt text eol=lf
tools/vmtest/expected-fair/*.txt text eol=lf
tools/vmtest/*.txt text eol=lf
