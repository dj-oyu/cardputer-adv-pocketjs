# Layered over sdkconfig.defaults for the PGO training image only
# (tools/pgo/train.sh): the gcov counters live in QEMU's PSRAM (-m 4M).
# Nothing here changes how the QuickJS component is compiled.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# Instrumented at -O2 the image outgrows the 1.5 MB app partition.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=n
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_pgo.csv"
